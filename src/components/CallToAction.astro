---
import { site } from '~/data/site';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Get a free estimate',
  body = 'Tell us what needs doing and we will come out, look at it, and give you a written price at no cost.',
} = Astro.props;
---

<section class="bg-brand-800">
  <div class="mx-auto max-w-4xl px-4 py-16 text-center text-white">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100">{body}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 font-bold text-white shadow-lg transition-colors hover:bg-accent-600"
      >
        Request an Estimate
        <Icon name="arrow" class="h-5 w-5" />
      </a>
      <a
        href={site.phoneHref}
        class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/40 px-7 py-3.5 font-bold text-white transition-colors hover:bg-white/10"
      >
        <Icon name="phone" class="h-5 w-5" />
        {site.phone}
      </a>
    </div>
  </div>
</section>
