---
import type { Service } from '~/data/site';
import Icon from './Icon.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  class="group flex flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
>
  <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-700 group-hover:text-white">
    <Icon name={service.icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-4 text-lg font-bold text-ink-950">{service.name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{service.summary}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700">
    Learn more
    <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
