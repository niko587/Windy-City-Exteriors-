---
import { site, services } from '~/data/site';
import { warnOnce } from '~/lib/warnOnce';

// Until a form endpoint is configured the form falls back to the visitor's own
// mail client, so it always does something rather than silently dropping leads.
const hasEndpoint = site.formEndpoint.length > 0;
const action = hasEndpoint ? site.formEndpoint : `mailto:${site.email}`;

if (!hasEndpoint) {
  warnOnce(
    '[quote form] site.formEndpoint is empty, so the form falls back to mailto. ' +
      'Set it in src/data/site.ts before launch — see README.md.'
  );
}

const fieldClass =
  'w-full rounded-lg border border-ink-300 bg-white px-3.5 py-2.5 text-ink-900 shadow-sm placeholder:text-ink-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-200';
const labelClass = 'block text-sm font-semibold text-ink-800';
---

<form
  action={action}
  method="post"
  enctype={hasEndpoint ? undefined : 'text/plain'}
  class="space-y-5 rounded-2xl border border-ink-200 bg-ink-50 p-6 shadow-sm sm:p-8"
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={labelClass} for="name">Name <span class="text-accent-700">*</span></label>
      <input class={`mt-1.5 ${fieldClass}`} type="text" id="name" name="name" autocomplete="name" required />
    </div>
    <div>
      <label class={labelClass} for="phone">Phone <span class="text-accent-700">*</span></label>
      <input class={`mt-1.5 ${fieldClass}`} type="tel" id="phone" name="phone" autocomplete="tel" required />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={labelClass} for="email">Email</label>
      <input class={`mt-1.5 ${fieldClass}`} type="email" id="email" name="email" autocomplete="email" />
    </div>
    <div>
      <label class={labelClass} for="zip">Property ZIP code</label>
      <input
        class={`mt-1.5 ${fieldClass}`}
        type="text"
        id="zip"
        name="zip"
        inputmode="numeric"
        autocomplete="postal-code"
        pattern="[0-9]{5}"
        placeholder="60618"
      />
    </div>
  </div>

  <div>
    <label class={labelClass} for="service">What do you need?</label>
    <select class={`mt-1.5 ${fieldClass}`} id="service" name="service">
      <option value="">Not sure yet</option>
      {services.map((service) => <option value={service.name}>{service.name}</option>)}
      <option value="Something else">Something else</option>
    </select>
  </div>

  <div>
    <label class={labelClass} for="message">Tell us about the job</label>
    <textarea
      class={`mt-1.5 ${fieldClass}`}
      id="message"
      name="message"
      rows="4"
      placeholder="Age of the roof, where the leak is, what you have noticed — whatever you know."></textarea>
  </div>

  <!-- Honeypot: hidden from people, filled in by most bots. -->
  <div class="hidden" aria-hidden="true">
    <label for="company">Company</label>
    <input type="text" id="company" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <button
    type="submit"
    class="w-full rounded-lg bg-accent-600 px-6 py-3.5 font-bold text-white shadow-sm transition-colors hover:bg-accent-700 sm:w-auto"
  >
    Request My Free Estimate
  </button>

  <p class="text-sm text-ink-600">
    We will get back to you within one business day. No cost, no obligation, and we will not pass your details to
    anyone else.
  </p>
</form>
